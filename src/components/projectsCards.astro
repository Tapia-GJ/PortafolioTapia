---
import GithubIcon from "@/components/icons/github.astro";
import type { Proyecto } from "@/types/project";
interface Props {
  proyecto: Proyecto;
  [key: string]: any;
}
const { proyecto, ...otherProps } = Astro.props;

const badgeConfig = {
  personal: { label: "Personal", class: "bg-blue-500/20 text-blue-400" },
  profesional: {
    label: "Experiencia Profesional",
    class: "bg-emerald-500/20 text-emerald-400",
  },
};
const badge = badgeConfig[proyecto.categoria];
---

<div
  class="bg-[#1a1a1a] p-6 rounded-lg hover:border hover:border-[#51F9F1] transition-all relative group"
  {...otherProps}
>
  <div class="flex flex-col mb-2 gap-1">
    <h3 class="text-xl font-light text-[#51F9F1]">
      {proyecto.nombreProyecto}
    </h3>
    <span
      class:list={[
        "w-fit px-2 py-0.5 rounded-full text-xs font-medium whitespace-nowrap",
        badge.class,
      ]}
    >
      {badge.label}
    </span>
  </div>
  <img
    src={proyecto.img}
    alt={proyecto.nombreProyecto}
    class="w-full rounded-lg mb-4"
    loading="lazy"
  />
  <p class="text-gray-300 mb-4">
    {proyecto.descripcion}
  </p>
  <div class="flex flex-wrap gap-2 mb-4">
    {
      proyecto.stack.map((tecnologia) => (
        <span class="px-3 py-1 bg-[#2d2d2d] rounded-full text-sm">
          {tecnologia}
        </span>
      ))
    }
  </div>

  <div class="flex gap-4">
    <a
      href={proyecto.linkDetalle}
      class="flex items-center text-[#51F9F1] hover:text-[#48bcb6] transition-colors before:absolute before:inset-0"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="w-5 h-5 mr-1"
        fill="currentColor"
        viewBox="0 0 20 20"
      >
        <path
          d="M10 3a2 2 0 110 4 2 2 0 010-4zm0 5a2 2 0 110 4 2 2 0 010-4zm0 5a2 2 0 110 4 2 2 0 010-4z"
        ></path>
      </svg>
      Más
    </a>
    {
      proyecto.hasRepositorio && (
        <a
          href={proyecto.linkRepositorio}
          target="_blank"
          class="flex items-center text-[#51F9F1] hover:text-[#48bcb6] transition-colors relative z-10"
        >
          <GithubIcon class="w-5 h-5 mr-1" />
          Código
        </a>
      )
    }
    {
      proyecto.hasLink && (
        <a
          href={proyecto.linkSitioWeb}
          target="_blank"
          class="flex items-center text-[#51F9F1] hover:text-[#48bcb6] transition-colors relative z-10"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-5 h-5 mr-1"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
            />
          </svg>
          Ir al sitio
        </a>
      )
    }
  </div>
</div>
