---
import Layout from "@/layouts/Layout.astro";
import ProyectoCard from "@/components/projectsCards.astro";
import type { Proyecto } from "@/types/project";
import AboutMe from "@/components/AboutMe.astro";
import Hero from "@/components/Hero.astro";
const Proyectos: Proyecto[] = [
  {
    id: "1",
    descripcion:
      "Desarrollo de un sistema integral que incluye módulos para gestión de empresas clientes, control de herramientas, inventario, servicios y tareas pendientes.",
    hasRepositorio: true,
    img: "/static/TallerCastillo.jpeg",
    nombreProyecto:
      "Sistema de Gestión de Empresarial con control de Herramientas y Servicios",
    stack: ["FullStack", "React", "NestJs", "MySQL"],
    categoria: "personal",
    linkRepositorio: "https://github.com/Tapia-GJ/TallerCastillo",
    linkDetalle: "proyectoTaller",
  },
  {
    id: "2",
    nombreProyecto: "Sistema Academia",
    descripcion:
      "Plataforma web donde los alumnos pueden consultar sus calificaciones y asignaturas, los profesores gestionar las notas de sus estudiantes y los administradores controlar la información de alumnos y profesores.",
    img: "/static/Academia.png",
    stack: ["Fullstack", "PHP", "HTML", "CSS", "MySQL"],
    categoria: "personal",
    hasRepositorio: true,
    linkRepositorio: "https://github.com/Tapia-GJ/SistemaAcademia",
    linkDetalle: "proyectoAcademia",
  },
  {
    id: "3",
    nombreProyecto: "App Web Registro de Lesiones",
    descripcion:
      "Plataforma web donde los usuarios pueden registrar sus lesiones y consultar las que tienen asignadas.",
    img: "/static/TerapiaFisica.png",
    stack: ["Frontend", "Python", "Flask", "HTML", "CSS", "MySQL"],
    categoria: "personal",
    linkDetalle: "/proyectoTerapia",
  },
  {
    id: "4",
    nombreProyecto: "Ecommerce de Pines y Llaveros",
    descripcion:
      "Aplicación web fullstack desarrollada para la venta de pines y llaveros personalizados.",
    img: "/static/ecomercePines.png",
    stack: [
      "Fullstack",
      "React",
      "TypeScript",
      "TailwindCSS",
      "Mercado Pago",
      "Supabase",
    ],
    categoria: "personal",
    hasRepositorio: true,
    linkRepositorio: "https://github.com/Tapia-GJ/EcomerceFront-Backend",
    hasLink: true,
    linkSitioWeb: "https://chibiquiles.netlify.app/",
    linkDetalle: "proyectoEcomerce",
  },
  {
    id: "5",
    nombreProyecto: "Plataforma Residencial SCA",
    descripcion:
      "Sistema integral para la administración de complejos residenciales. Rediseño de interfaz móvil y desarrollo de módulos web para control de accesos, cuentas por cobrar y gestión de obras.",
    img: "/static/sca/sca_main.png",
    stack: [
      "Frontend",
      "Angular",
      "TypeScript",
      "TailwindCSS",
      "Figma",
      "PrimeNG",
    ],
    categoria: "profesional",
    hasLink: true,
    linkSitioWeb: "https://scaresidencial.com/app/login",
    linkDetalle: "proyectoResidencial",
  },
  {
    id: "6",
    nombreProyecto: "PADI - Gestión de Proyectos",
    descripcion:
      "Módulo financiero para una plataforma corporativa. Desarrollo fullstack con enfoque principal en frontend y apoyo en backend para la integración de procesos de compras, solicitudes de pago y caja chica.",
    img: "/static/padi/padi_main.png",
    stack: [
      "Fullstack",
      "React",
      "TypeScript",
      "TailwindCSS",
      "API REST",
      "Shadcn",
      "Nodejs",
      "Express",
    ],
    categoria: "profesional",
    linkDetalle: "proyectoPADI",
    hasLink: true,
    linkSitioWeb: "https://padi-dashboard.vercel.app",
  },
];
---

<Layout title="Portafolio Luis Tapia">
  <main class="pb-12">
    <!-- Hero -->
    <Hero />
    <!-- Sobre Mí -->
    <AboutMe />

    <!-- Proyectos -->
    <section id="proyectos" class="w-full mx-auto lg:w-[744px] py-8">
      <h1 class="text-3xl font-light mb-6">Proyectos</h1>

      <!-- Filtros -->
      <div class="flex gap-3 mb-6" id="filtros-proyectos">
        <button
          data-filter="todos"
          class="filter-btn px-4 py-2 rounded-full text-sm font-medium transition-all bg-[#51F9F1] text-black"
        >
          Todos
        </button>
        <button
          data-filter="profesional"
          class="filter-btn px-4 py-2 rounded-full text-sm font-medium transition-all bg-[#2d2d2d] text-gray-300 hover:bg-[#51F9F1] hover:text-black"
        >
          Experiencia Profesional
        </button>
        <button
          data-filter="personal"
          class="filter-btn px-4 py-2 rounded-full text-sm font-medium transition-all bg-[#2d2d2d] text-gray-300 hover:bg-[#51F9F1] hover:text-black"
        >
          Proyectos Personales
        </button>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6" id="grid-proyectos">
        {
          Proyectos.map((proye: Proyecto) => (
            <ProyectoCard proyecto={proye} data-categoria={proye.categoria} />
          ))
        }
      </div>
    </section>
  </main>
</Layout>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const botones = document.querySelectorAll<HTMLButtonElement>(".filter-btn");
    const cards = document.querySelectorAll<HTMLElement>(
      "#grid-proyectos > div",
    );

    botones.forEach((btn) => {
      btn.addEventListener("click", () => {
        const filtro = btn.dataset.filter;

        // Actualizar estilos de botones
        botones.forEach((b) => {
          b.classList.remove("bg-[#51F9F1]", "text-black");
          b.classList.add("bg-[#2d2d2d]", "text-gray-300");
        });
        btn.classList.remove("bg-[#2d2d2d]", "text-gray-300");
        btn.classList.add("bg-[#51F9F1]", "text-black");

        // Filtrar cards
        cards.forEach((card) => {
          if (filtro === "todos" || card.dataset.categoria === filtro) {
            card.style.display = "";
          } else {
            card.style.display = "none";
          }
        });
      });
    });
  });
</script>
