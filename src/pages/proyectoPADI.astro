---
import Badge from "@/components/Badge.astro";
import Layout from "@/layouts/Layout.astro";
---

<Layout title="PADI – Gestión de Proyectos | Portafolio Luis Tapia">
  <main>
    <section class="w-full mx-auto lg:w-[740px] py-24 px-4">
      <h1 class="text-4xl font-medium text-center text-[#51F9F1] mb-2">
        PADI - Gestión de Proyectos
      </h1>
      <div class="flex justify-center mb-4">
        <span
          class="px-3 py-1 rounded-full text-center text-sm font-medium text-gray-300"
        >
          Experiencia Profesional · Paredes y Asociados Constructores
        </span>
      </div>
      <div
        class="flex flex-wrap gap-2 mb-8 justify-center text-lg text-gray-300"
      >
        <Badge tecnologia="Fullstack" />
        <Badge tecnologia="React" />
        <Badge tecnologia="TypeScript" />
        <Badge tecnologia="TailwindCSS" />
        <Badge tecnologia="Shadcn/ui" />
        <Badge tecnologia="Node.js" />
        <Badge tecnologia="Express" />
        <Badge tecnologia="API REST" />
      </div>

      <img
        src="/static/padi/padi_main.png"
        alt="PADI – Vista principal"
        class="w-full rounded-lg mb-6 lightbox-img"
      />
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pb-6">
        <img
          src="/static/padi/padi_1.png"
          alt="PADI – Módulo de Compras"
          class="w-full md:h-[180px] rounded-lg object-cover lightbox-img"
        />
        <img
          src="/static/padi/padi_2.png"
          alt="PADI – Solicitudes de Pago"
          class="w-full md:h-[180px] rounded-lg object-cover lightbox-img"
        />
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pb-6">
        <img
          src="/static/padi/padi_3.png"
          alt="PADI – Caja Chica"
          class="w-full md:h-[180px] rounded-lg object-cover lightbox-img"
        />
        <img
          src="/static/padi/padi_4.png"
          alt="PADI – Rediseño de vistas"
          class="w-full md:h-[180px] rounded-lg object-cover lightbox-img"
        />
      </div>

      <div class="space-y-8">
        <section>
          <h2 class="text-2xl text-[#51F9F1] mb-4">Descripción</h2>
          <p class="text-gray-300">
            Participé en el desarrollo frontend de una plataforma web
            corporativa de tesorería utilizando React, TypeScript y TailwindCSS,
            colaborando en reuniones técnicas para la definición de tareas y
            revisión de avances. Implementé e integré módulos clave conectados a
            la API REST, y contribuí al rediseño de diversas vistas creando
            componentes reutilizables y estructuras responsivas adaptadas a un
            nuevo sistema de diseño orientado a mejorar la accesibilidad y la
            experiencia del usuario.
          </p>
        </section>

        <section>
          <h2 class="text-2xl text-[#51F9F1] mb-4">Módulos Principales</h2>
          <ul class="space-y-3 text-gray-300">
            <li class="flex items-start">
              <span class="mr-2 mt-0.5">✅</span>
              <span>
                <strong class="text-white font-medium">Compras:</strong> gestión de
                órdenes mediante listas, filtros, vistas detalladas y funcionalidades
                para crear, visualizar y cancelar órdenes.
              </span>
            </li>
            <li class="flex items-start">
              <span class="mr-2 mt-0.5">✅</span>
              <span>
                <strong class="text-white font-medium"
                  >Solicitudes de Pago:</strong
                > registro, autorización y programación de pagos con flujo de estados
                integrado.
              </span>
            </li>
            <li class="flex items-start">
              <span class="mr-2 mt-0.5">✅</span>
              <span>
                <strong class="text-white font-medium">Autorizar Pagos:</strong> control
                de fondos menores con registro de movimientos y reportes de saldo.
              </span>
            </li>
            <li class="flex items-start">
              <span class="mr-2 mt-0.5">✅</span>
              <span>
                <strong class="text-white font-medium"
                  >Rediseño de vistas:</strong
                > creación de componentes reutilizables y estructuras responsivas
                alineadas al nuevo sistema de diseño.
              </span>
            </li>
          </ul>
        </section>

        <section>
          <h2 class="text-2xl text-[#51F9F1] mb-4">Tecnologías Clave</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-gray-300">
            <div>
              <p class="font-medium">Frontend:</p>
              <p>React + TypeScript + TailwindCSS + Shadcn/ui</p>
            </div>
            <div>
              <p class="font-medium">Backend:</p>
              <p>Node.js + Express + API REST</p>
            </div>
            <div>
              <p class="font-medium">Arquitectura:</p>
              <p>Componentes reutilizables y estructuras responsivas</p>
            </div>
          </div>
        </section>

        <section>
          <h2 class="text-2xl text-[#51F9F1] mb-4">Logros Destacados</h2>
          <ul class="space-y-3 text-gray-300">
            <li class="flex items-center">
              <span class="mr-2">✔️</span>Integración de módulos clave de
              tesorería con la API REST
            </li>
            <li class="flex items-center">
              <span class="mr-2">✔️</span>Participación activa en reuniones
              técnicas de definición y revisión
            </li>
            <li class="flex items-center">
              <span class="mr-2">✔️</span>Componentes reutilizables que
              aceleraron el desarrollo de nuevas vistas
            </li>
            <li class="flex items-center">
              <span class="mr-2">✔️</span>Mejora en accesibilidad y experiencia
              de usuario en toda la plataforma
            </li>
          </ul>
        </section>
      </div>
    </section>
  </main>
</Layout>
